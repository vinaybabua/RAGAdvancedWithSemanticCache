# ============================================================================
# APP -> LiteLLM gateway
# The app no longer needs Anthropic or Hugging Face keys; it only talks to
# the gateway.
# ============================================================================
LITELLM_BASE_URL=http://localhost:4000
# Gateway master key (or a virtual key created on the gateway).
# Must match LITELLM_MASTER_KEY below when using the master key.
LITELLM_API_KEY=sk-REPLACE_WITH_YOUR_GENERATED_KEY

# Gateway model aliases (defined in gateway/litellm_config.yaml)
LLM_MODEL=claude-chat
EMBEDDING_MODEL=hf-embeddings
EMBEDDING_BATCH_SIZE=32

# Real model name behind LLM_MODEL -- used only for semantic-cache
# cost-savings tracking (BetterDB cost table).
CACHE_COST_MODEL=claude-sonnet-4-5

# ============================================================================
# LiteLLM gateway (read by the `litellm` process, not by the app)
# Keep these here only if you start the gateway from this folder; in a
# shared gateway they would live on the gateway host instead.
# ============================================================================
# LiteLLM refuses to start with a weak/default key (e.g. sk-1234). Generate one:
#   python -c "import secrets; print('sk-' + secrets.token_hex(32))"
LITELLM_MASTER_KEY=sk-REPLACE_WITH_YOUR_GENERATED_KEY
ANTHROPIC_API_KEY=
# Hugging Face token (read access) for the HF Inference API embeddings
HF_TOKEN=
# OPENAI_API_KEY=

# ============================================================================
# Valkey connection (semantic cache backend)
# ============================================================================

# Set to "true" once you're pointing at the real AWS endpoint below.
# Keep it "false" for local dev against a plain local Valkey/Redis instance.
VALKEY_USE_IAM_AUTH=false

# The cache's PUBLIC ENDPOINT hostname (everything between rediss:// and :6379
# in the URL AWS gave you) - NOT "localhost" once this is pointed at AWS.
#VALKEY_HOST=betterdbscache-xder27.public.serverless.use2.cache.amazonaws.com
VALKEY_HOST=localhost
VALKEY_PORT=6379

# The short NAME of the serverless cache resource (ElastiCache > Serverless
# caches in the AWS console) - NOT the hostname above.
#VALKEY_SERVERLESS_CACHE_NAME=betterdbscache

# The IAM-authenticated Valkey user configured on the cache's user group.
VALKEY_IAM_USER_ID=default.iam-user

# Region derived from "use2" in the hostname = us-east-2.
AWS_REGION=us-east-2

# Namespace prefix for this app's semantic-cache keys. A new name so cached
# vectors from the old (local HF) project are never mixed with these.
SEMANTIC_CACHE_NAME=betterdbscache_litellm

# ----------------------------------------------------------------------------
# AWS credentials used locally to SIGN the IAM auth token.
# Prefer `aws configure` / a shared credentials file over hardcoding these.
# ----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

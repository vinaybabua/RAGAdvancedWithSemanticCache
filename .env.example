# Add your OpenAI API Key here
#OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=anthropic/claude-haiku-4-5
# Valkey connection (semantic cache backend)
#VALKEY_HOST=localhost
#VALKEY_PORT=6379
#ANTHROPIC_API_KEY=
#LLM_MODEL=anthropic/claude-haiku-4-5

# ----------------------------------------------------------------------------
# AWS Valkey connection (semantic cache backend)
# ----------------------------------------------------------------------------

# Set to "true" once you're pointing at the real AWS endpoint below.
# Keep it "false" for local dev against a plain local Valkey/Redis instance.
VALKEY_USE_IAM_AUTH=false

# The cache's PUBLIC ENDPOINT hostname (everything between rediss:// and :6379
# in the URL AWS gave you) Ã¢â‚¬â€ NOT "localhost" once this is pointed at AWS.
#VALKEY_HOST=betterdbscache-xder27.public.serverless.use2.cache.amazonaws.com
VALKEY_HOST=localhost
VALKEY_PORT=6379

# The short NAME of the serverless cache resource (check the exact value in
# the AWS console under ElastiCache > Serverless caches Ã¢â‚¬â€ it is NOT the
# hostname above).
#VALKEY_SERVERLESS_CACHE_NAME=betterdbscache

# The IAM-authenticated Valkey user configured on the cache's user group.
VALKEY_IAM_USER_ID=default.iam-user

# Region derived from "use2" in the hostname = us-east-2.
AWS_REGION=us-east-2

# Namespace prefix for this app's semantic-cache keys (avoids collisions
# across environments/apps sharing the same cache).
SEMANTIC_CACHE_NAME=betterdbscache_hf

# ----------------------------------------------------------------------------
# AWS credentials used locally to SIGN the IAM auth token.
# Prefer `aws configure` / a shared credentials file over hardcoding these
# here. Only set them directly if you have no other way to supply them.
# ----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ----------------------------------------------------------------------------
# OpenAI (embeddings + LLM)
# ----------------------------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-5
HF_DEVICE=cpu
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2